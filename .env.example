# Variables de entorno de DominIA Agentes.
#
# En local no hace falta tocar nada: `pnpm dev` (o `pnpm run setup`) crea `.env.local` a partir de estos
# valores y genera los secretos al azar. `.env.local` nunca se sube a Git.
# Al publicar en Vercel, las marcadas [SECRETO] se crean como «Sensitive» (docs/plataforma-despliegue.md).
# Nunca pongas una clave secreta en una variable que empiece por NEXT_PUBLIC_: llegaría al navegador.

# --- Base de datos -----------------------------------------------------------------------------------------

# [SECRETO] Conexión con la base de datos (Postgres). Vacía en local: la base integrada (PGlite) en data/pglite, sin
# cuentas ni Docker. Al publicar, la cadena del «Transaction pooler» de Supabase (botón Connect, puerto 6543):
# postgresql://postgres.<ref>:<contraseña>@aws-….pooler.supabase.com:6543/postgres
# Lleva la contraseña de la base: es secreta, nunca la subas a Git. En un servidor propio (VPS), la del
# «Session pooler» (puerto 5432).
DATABASE_URL=

# --- Direcciones de la app ---------------------------------------------------------------------------------

# Dirección pública de la app: con ella se montan los enlaces de los correos, los webhooks y el OAuth.
# Al publicar, el dominio de producción (https://…), nunca la URL de una preview.
APP_URL=http://localhost:3000

# Dirección que usa el inicio de sesión (Better Auth). La misma que APP_URL.
BETTER_AUTH_URL=http://localhost:3000

# La versión compilada (`pnpm start`, Vercel o un servidor propio) no arranca si APP_URL o BETTER_AUTH_URL no empiezan
# por https://. Solo en tu propio ordenador sirve http://localhost (al arrancar avisa de que solo funciona ahí).

# Cuántos proxies hay delante de la app y escriben la IP del cliente en X-Forwarded-For, para que nadie se salte
# los límites por IP inventándose una. Sin poner vale 1: Vercel, o Traefik en Dokploy. 2 si hay otro más delante
# (por ejemplo, Cloudflare). 0 solo si la app se expone sin proxy: entonces no se fía de ninguna cabecera y todos
# comparten los límites por IP.
# TRUSTED_PROXY_HOPS=1

# --- Secretos de la instalación (en local los genera `pnpm dev`) --------------------------------------------

# [SECRETO] Firma las sesiones y cifra los secretos de la verificación en dos pasos.
# Al menos 32 caracteres al azar. Cambiarla deja sin verificación en dos pasos a todos los usuarios.
BETTER_AUTH_SECRET=

# [SECRETO] Cifra las claves que el negocio pone en la app (Meta, OpenRouter, correo…): 32 bytes al azar en
# Base64. Guárdala también en un gestor de contraseñas: si se pierde, esas claves no se pueden leer.
APP_ENCRYPTION_KEY=

# [SECRETO] Protege /api/cron/tick: quien llama al trabajo en segundo plano debe enviar
# «Authorization: Bearer <CRON_SECRET>». Largo y al azar.
CRON_SECRET=

# [SECRETO] Código de instalación: en una instalación publicada, el primer paso del asistente de arranque lo pide
# para crear el propietario, y sin él nadie puede crearlo. En local (`pnpm dev`) no hace falta: déjalo vacío.
# Al publicar, al menos 32 caracteres al azar (docs/guia-despliegue.md).
SETUP_TOKEN=

# --- Demo --------------------------------------------------------------------------------------------------

# true: aviso «Modo demo» y canales de demo que nunca llaman a servicios reales. Solo en local;
# en una instalación publicada, false o sin poner.
DEMO_MODE=true

# --- IA ----------------------------------------------------------------------------------------------------

# [SECRETO] Clave de OpenRouter (opcional). Mejor ponerla en la app, en Ajustes › IA: si hay clave en los dos
# sitios, manda la de Ajustes. Sin clave, la IA está apagada y la búsqueda va solo por texto.
OPENROUTER_API_KEY=

# --- Archivos ----------------------------------------------------------------------------------------------

# Dónde se guardan los archivos (fotos, audios, documentos, logos). Con estas dos vacías, en el disco: data/uploads.
# Al publicar, en Supabase Storage, en un bucket privado («dominia-archivos») que la app crea sola la primera vez.
# En Vercel hacen falta las dos: su disco no conserva los archivos.
# SUPABASE_URL es la «Project URL» del proyecto (botón Connect de Supabase).
SUPABASE_URL=

# [SECRETO] La «secret key» de Supabase (empieza por sb_secret_): Project Settings › API Keys. Se salta Row Level
# Security, así que solo va en el servidor: nunca en una variable NEXT_PUBLIC_. En Vercel, márcala como Sensitive.
SUPABASE_SECRET_KEY=

# Ruta de otro FFmpeg para convertir notas de voz a MP3 (opcional). Sin poner, se usa el de ffmpeg-static.
# En un servidor propio (Docker) se puede instalar el FFmpeg del sistema y apuntar aquí.
# FFMPEG_BIN=/usr/bin/ffmpeg

# --- Correo (IMAP/SMTP) ------------------------------------------------------------------------------------

# true: permite servidores de correo en la red local (un servidor de correo propio junto a la app). Sin poner, la
# app solo se conecta a direcciones públicas, para que nadie la use para llegar a la red interna del servidor.
# ALLOW_PRIVATE_MAIL_HOSTS=false

# true (solo en un servidor propio con `pnpm worker`): mantiene abierta la conexión IMAP de los buzones que lo
# tengan activado y lee el correo nuevo en cuanto llega. Sin poner, se lee cada minuto.
# EMAIL_IMAP_IDLE=false

# --- Herramientas HTTP de los agentes -----------------------------------------------------------------------

# Solo para desarrollo y pruebas. true: las herramientas HTTP también pueden llamar a este ordenador o a la red local,
# incluso sin HTTPS (por ejemplo, un n8n de pruebas en http://localhost:5678). Con `pnpm dev` ya se permite sin
# ponerla. La versión compilada (NODE_ENV=production) no arranca con ella, salvo en las pruebas de Playwright: una
# instalación publicada solo llama a servicios públicos con HTTPS, para que nadie use las herramientas para llegar a la
# red interna del servidor ([HER-14]).
# ALLOW_LOCAL_HTTP_TOOLS=false

# --- Direcciones de los servicios externos (solo para pruebas) ---------------------------------------------
# Sin poner, la app usa las direcciones reales. Las pruebas de Playwright las apuntan a su simulador
# (e2e/mocks/). No las cambies en una instalación real.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# META_GRAPH_BASE_URL=https://graph.facebook.com
# GOOGLE_OAUTH_BASE_URL=       (acceso de Google; por defecto, las direcciones reales de Google)
# GOOGLE_API_BASE_URL=         (API de Gmail; por defecto, la real)
# MS_LOGIN_BASE_URL=https://login.microsoftonline.com
# MS_GRAPH_BASE_URL=https://graph.microsoft.com
# MISTRAL_BASE_URL=https://api.mistral.ai
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# true solo en los servidores de Playwright: deja arrancar la versión compilada (NODE_ENV=production) con esas
# direcciones cambiadas y con ALLOW_LOCAL_HTTP_TOOLS. Sin él, la versión compilada se niega a arrancar con
# cualquiera de ellas. Nunca en una instalación real.
# E2E_ALLOW_BASE_URL_OVERRIDES=true

# Espera fija, en milisegundos, antes de que la IA responda (solo pruebas). Sin poner, la app espera entre 4 y
# 8 segundos para juntar varios mensajes seguidos en una sola respuesta. No la pongas en una instalación real.
# REPLY_DEBOUNCE_MS=500
