# Variables de entorno de DominIA Agentes.
#
# En local no hace falta tocar nada: `pnpm dev` (o `pnpm run setup`) crea `.env.local` a partir de estos
# valores y genera los secretos al azar. `.env.local` nunca se sube a Git.
# Al publicar en Vercel, las marcadas [SECRETO] se crean como «Sensitive» (docs/plataforma-despliegue.md).
# Nunca pongas una clave secreta en una variable que empiece por NEXT_PUBLIC_: llegaría al navegador.

# --- Base de datos -----------------------------------------------------------------------------------------

# Dónde está la base de datos. En local, un archivo SQLite (libSQL) dentro de data/.
# Al publicar, la URL de Turso: libsql://<base>-<organización>.turso.io
DATABASE_URL=file:./data/local.db

# [SECRETO] Token de Turso. Vacío en local (el archivo no lo necesita).
DATABASE_AUTH_TOKEN=

# --- Direcciones de la app ---------------------------------------------------------------------------------

# Dirección pública de la app: con ella se montan los enlaces de los correos, los webhooks y el OAuth.
# Al publicar, el dominio de producción (https://…), nunca la URL de una preview.
APP_URL=http://localhost:3000

# Dirección que usa el inicio de sesión (Better Auth). La misma que APP_URL.
BETTER_AUTH_URL=http://localhost:3000

# --- Secretos de la instalación (en local los genera `pnpm dev`) --------------------------------------------

# [SECRETO] Firma las sesiones y cifra los secretos de la verificación en dos pasos.
# Al menos 32 caracteres al azar. Cambiarla deja sin verificación en dos pasos a todos los usuarios.
BETTER_AUTH_SECRET=

# [SECRETO] Cifra las claves que el negocio pone en la app (Meta, OpenRouter, correo…): 32 bytes al azar en
# Base64. Guárdala también en un gestor de contraseñas: si se pierde, esas claves no se pueden leer.
APP_ENCRYPTION_KEY=

# [SECRETO] Protege /api/cron/tick: quien llama al trabajo en segundo plano debe enviar
# «Authorization: Bearer <CRON_SECRET>». Largo y al azar.
CRON_SECRET=

# [SECRETO] Código de instalación: en una instalación publicada, el primer paso del asistente de arranque lo pide
# para crear el propietario, y sin él nadie puede crearlo. En local (`pnpm dev`) no hace falta: déjalo vacío.
# Al publicar, al menos 32 caracteres al azar (docs/guia-despliegue.md).
SETUP_TOKEN=

# --- Demo --------------------------------------------------------------------------------------------------

# true: aviso «Modo demo» y canales de demo que nunca llaman a servicios reales. Solo en local;
# en una instalación publicada, false o sin poner.
DEMO_MODE=true

# --- IA ----------------------------------------------------------------------------------------------------

# [SECRETO] Clave de OpenRouter (opcional). Mejor ponerla en la app, en Ajustes › IA: si hay clave en los dos
# sitios, manda la de Ajustes. Sin clave, la IA está apagada y la búsqueda va solo por texto.
OPENROUTER_API_KEY=

# --- Archivos ----------------------------------------------------------------------------------------------

# [SECRETO] Token del almacén privado de Vercel Blob. Vacío en local: los archivos se guardan en data/uploads.
# Vercel la añade sola al conectar el almacén al proyecto (junto con BLOB_STORE_ID).
BLOB_READ_WRITE_TOKEN=

# Ruta de otro FFmpeg para convertir notas de voz a MP3 (opcional). Sin poner, se usa el de ffmpeg-static.
# En un servidor propio (Docker) se puede instalar el FFmpeg del sistema y apuntar aquí.
# FFMPEG_BIN=/usr/bin/ffmpeg

# --- Direcciones de los servicios externos (solo para pruebas) ---------------------------------------------
# Sin poner, la app usa las direcciones reales. Las pruebas de Playwright las apuntan a su simulador
# (e2e/mocks/). No las cambies en una instalación real.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# META_GRAPH_BASE_URL=https://graph.facebook.com
# GOOGLE_OAUTH_BASE_URL=       (acceso de Google; por defecto, las direcciones reales de Google)
# GOOGLE_API_BASE_URL=         (API de Gmail; por defecto, la real)
# MS_LOGIN_BASE_URL=https://login.microsoftonline.com
# MS_GRAPH_BASE_URL=https://graph.microsoft.com
# MISTRAL_BASE_URL=https://api.mistral.ai
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# Espera fija, en milisegundos, antes de que la IA responda (solo pruebas). Sin poner, la app espera entre 4 y
# 8 segundos para juntar varios mensajes seguidos en una sola respuesta. No la pongas en una instalación real.
# REPLY_DEBOUNCE_MS=500
